# TEMPLATE ONLY (the .example extension keeps `kubectl apply -f k8s/` from applying placeholder values).
# Preferred: run ./k8s/create-secrets.sh, which generates strong random values and never writes them to disk.
apiVersion: v1
kind: Secret
metadata:
  name: swiftdrop-secrets
  namespace: swiftdrop
type: Opaque
stringData:
  JWT_SECRET: "<openssl rand -base64 48>"
  DB_PASSWORD: "<strong password>"
  GOOGLE_CLIENT_ID: "<your Google OAuth client id>"
  # optional: first admin account created by auth-service on startup
  # ADMIN_EMAIL: "admin@example.com"
  # ADMIN_PASSWORD: "<min 8 chars>"
